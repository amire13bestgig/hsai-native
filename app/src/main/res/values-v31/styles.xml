<resources>
 <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:forceDarkAllowed">false</item>
  <item name="android:fontFamily">sans</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:windowActionModeOverlay">true</item>
  <item name="android:colorAccent">#CE9F58</item>
  <item name="android:windowBackground">@color/brand_navy_950</item>
  <!-- اسپلش اندروید ۱۲+: نشان با ناحیهٔ ایمن دایره‌ای، نه فایل ۶۲۰×۶۴۰ که لبه‌هایش بریده می‌شد. -->
  <item name="android:windowSplashScreenBackground">@color/brand_navy_950</item>
  <item name="android:windowSplashScreenAnimatedIcon">@drawable/brand_splash_icon</item>
  <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_navy_950</item>
 </style>
</resources>
